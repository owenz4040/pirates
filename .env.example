# Copy to .env and fill in (do not commit .env).
MIKROTIK_HOST=203.0.113.10
MIKROTIK_PORT=8729
MIKROTIK_USER=billing-api
MIKROTIK_PASSWORD=change-me
MIKROTIK_USE_SSL=true
# Leave false until you've installed a real cert on the router (see README).
MIKROTIK_VERIFY_SSL=false

DATABASE_URL=postgresql+psycopg://pirates:pirates-dev-password@localhost:5432/pirates

# Paystack - use the "test" secret key from your dashboard for sandbox testing.
PAYSTACK_SECRET_KEY=

# Admin dashboard login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs the admin dashboard's session cookie - generate with
# `python -c "import secrets; print(secrets.token_hex(32))"`. Keep it fixed
# so admins stay logged in across server restarts.
SESSION_SECRET_KEY=

# Africa's Talking - welcome SMS on signup. Use "sandbox" + your sandbox API
# key to test for free (only reaches numbers registered as test numbers in
# the AT dashboard); switch to your live username/key to text real customers.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Resend - welcome email on signup. Until you verify a domain at
# resend.com/domains, this can only deliver to your own account email.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=PIRATES WIFI <onboarding@resend.dev>

# Public URL this server is reachable at - needed for absolute links in
# emails (the "Pay Now" button). If you're using a permanent named
# Cloudflare Tunnel (see README), this stays fixed and never needs updating.
PUBLIC_BASE_URL=
